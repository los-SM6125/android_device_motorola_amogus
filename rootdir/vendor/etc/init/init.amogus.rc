on init
    # Boot time fs tune
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 256
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/dm-0/queue/read_ahead_kb 256
    write /sys/block/dm-1/queue/read_ahead_kb 256

on boot
    # update foreground cpuset now that processors are up
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/boost/cpus 0-7
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-1

    # Set the default IRQ affinity to the primary cluster. When a
    # CPU is isolated/hotplugged, the IRQ affinity is adjusted
    # to one of the CPU from the default IRQ affinity mask.
    write /proc/irq/default_smp_affinity f

on property:sys.boot_completed=1
    # Runtime fs tuning for runtime performance
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048

on property:ro.boot.device=sofia
    mount none /vendor/etc/camera/dual_golden_sofia.bin /vendor/etc/camera/dual_golden.bin bind
    mount none /vendor/etc/sensors/config-sofia /vendor/etc/sensors/config bind

on property:ro.boot.device=sofiap
    mount none /vendor/etc/sensors/config-sofia /vendor/etc/sensors/config bind

on property:ro.boot.device=sofiar
    mount none /vendor/etc/camera/dual_golden_sofiar.bin /vendor/etc/camera/dual_golden.bin bind
    mount none /vendor/etc/sensors/config-sofia /vendor/etc/sensors/config bind
    mount none /vendor/etc/sensors/config-sofiar/nicobar_ak991x_0.json /vendor/etc/sensors/config/nicobar_ak991x_0.json bind
    mount none /vendor/etc/sensors/config-sofiar/nicobar_icm4x6xx_0-i3c.json /vendor/etc/sensors/config/nicobar_icm4x6xx_0-i3c.json bind
    mount none /vendor/etc/sensors/config-sofiar/nicobar_lsm6dso_0.json /vendor/etc/sensors/config/nicobar_lsm6dso_0.json bind
    mount none /vendor/etc/sensors/config-sofiar/nicobar_mn29xxx_0.json /vendor/etc/sensors/config/nicobar_mn29xxx_0.json bind
    mount none /vendor/etc/sensors/config-sofiar/nicobar_mn59xxx_0.json /vendor/etc/sensors/config/nicobar_mn59xxx_0.json bind

# DualSIM
on property:ro.boot.dualsim=true
    setprop persist.radio.multisim.config dsds
